{
  "name": "first-light",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A local workspace for turning research findings into web applications.",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "npm run typecheck && vite build && npm run perf:budget",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc --noEmit && npm run server:typecheck",
    "perf:budget": "node scripts/check-performance-budget.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "moon:pack": "node scripts/pack-moon-glb.mjs public/media/moon/moon.gltf public/media/moon/moon.glb",
    "moon:test-packer": "node --test tests/pack-moon-glb.test.mjs",
    "moon:validate": "node scripts/validate-moon.mjs",
    "earth:validate": "node scripts/validate-earth.mjs",
    "sun:pack": "node scripts/pack-moon-glb.mjs public/media/sun/sun.gltf public/media/sun/sun.glb",
    "sun:validate": "node scripts/validate-sun.mjs",
    "check": "npm run moon:test-packer && npm run moon:validate && npm run earth:validate && npm run sun:validate && npm run typecheck && npm test && npm run server:test && npm run build",
    "server:dev": "node --env-file-if-exists=.env --import tsx --watch src/server/index.ts",
    "server:build": "tsc -p tsconfig.server.json",
    "server:start": "node --env-file-if-exists=.env dist-server/src/server/index.js",
    "server:typecheck": "tsc -p tsconfig.server.json --noEmit",
    "server:test": "npm run server:build && vitest run --config vitest.server.config.ts",
    "db:check": "node --env-file-if-exists=.env --import tsx src/server/scripts/check-db.ts",
    "sessions:revoke-user": "node --env-file-if-exists=.env --import tsx src/server/scripts/revoke-user-sessions.ts"
  },
  "dependencies": {
    "@fontsource/poppins": "5.3.0",
    "@react-three/drei": "10.7.9",
    "@react-three/fiber": "9.8.2",
    "@react-three/postprocessing": "3.2.2",
    "framer-motion": "11.18.2",
    "mongoose": "9.12.1",
    "postprocessing": "6.36.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-parallax-tilt": "1.7.352",
    "three": "0.167.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/three": "0.167.2",
    "@vitejs/plugin-react": "^5.0.0",
    "gltf-validator": "2.0.0-dev.3.10",
    "jsdom": "^26.1.0",
    "tsx": "4.23.15",
    "typescript": "~5.9.0",
    "vite": "^7.0.0",
    "vitest": "^3.2.4"
  }
}
