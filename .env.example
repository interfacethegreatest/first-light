# Server-only configuration. Never prefix database secrets with VITE_.
MONGODB_URI=mongodb://127.0.0.1:27017/first_light
HOST=127.0.0.1
PORT=3001
# Browser origin allowed to make session-changing requests.
# Use your HTTPS site origin and NODE_ENV=production when hosting the backend.
APP_ORIGIN=http://127.0.0.1:5173
SESSION_TTL_DAYS=30

# Public feature flag only: enables same-origin account/research integration.
# Keep false/unset for GitHub Pages, which cannot run the API.
VITE_API_ENABLED=true
